DATABASE_URL="postgresql://lt:lt@localhost:5432/lt"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
# CORS を許可するフロントエンドのオリジン
WEB_ORIGIN="http://localhost:3000"
# レート制限で利用者の IP を知るため、X-Forwarded-For を付けるプロキシ（web の BFF 等）を信頼する範囲。
# Express の trust proxy と同じ書式（"loopback" / ホップ数 / IP・CIDR のカンマ区切り）。
# web と api が別ホストなら web サーバーの IP / CIDR を指定する。ホップ数は接続元を問わず X-Forwarded-For を信じるため、
# api に直接届くリクエストが IP を偽装してレート制限を回避できる（api は外部に公開しないこと）。
# 設定し忘れると全利用者が web の IP 1 つを共有し、サービス全体で上限を分け合うことになる
TRUST_PROXY="loopback"
# 通知に含めるリンクの元になる URL
WEB_URL="http://localhost:3000"
# パスワード再設定メールの送信（Resend）。未設定ならメールは送らず api のログに出す
RESEND_API_KEY=""
MAIL_FROM=""
# 全体向けの Discord Webhook URL。未設定なら全体向けの通知はスキップされる（LT会ごとの通知先は主催者が画面で設定する）
DISCORD_WEBHOOK_URL=""
