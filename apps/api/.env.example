DATABASE_URL="postgresql://lt:lt@localhost:5432/lt"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
# CORS を許可するフロントエンドのオリジン
WEB_ORIGIN="http://localhost:3000"
# レート制限で利用者の IP を知るため、X-Forwarded-For を付けるプロキシ（web の BFF 等）を信頼する範囲。
# Express の trust proxy と同じ書式（"loopback" / ホップ数 / IP・CIDR のカンマ区切り）。web と api が別ホストなら web 側の IP かホップ数にする
TRUST_PROXY="loopback"
# 通知に含めるリンクの元になる URL
WEB_URL="http://localhost:3000"
# Discord の Webhook URL。未設定なら通知はスキップされる
DISCORD_WEBHOOK_URL=""
