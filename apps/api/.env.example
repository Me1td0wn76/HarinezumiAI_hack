DATABASE_URL="postgresql://lt:lt@localhost:5432/lt"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
# CORS を許可するフロントエンドのオリジン
WEB_ORIGIN="http://localhost:3000"
# 通知に含めるリンクの元になる URL
WEB_URL="http://localhost:3000"
# Google ログイン（任意）。未設定ならボタンを出さない。手順は README の「Google ログインを有効にする」
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Discord の Webhook URL。未設定なら通知はスキップされる
DISCORD_WEBHOOK_URL=""
